{
  "name": "@jemmy8oy-northstar/design-system",
  "version": "0.1.0",
  "description": "Northstar design system — a themeable React component library. Casual coral/teal theme first; themes swap at the semantic-token layer.",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src/tokens"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/design-system.css",
    "./tokens.css": "./dist/design-system.css",
    "./tokens/*": "./src/tokens/*"
  },
  "scripts": {
    "dev": "vite --config vite.showcase.config.ts",
    "build": "tsc -b && vite build",
    "prepare": "npm run build",
    "build:showcase": "vite build --config vite.showcase.config.ts",
    "preview": "vite preview --config vite.showcase.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "test:e2e": "playwright test"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.14",
    "vite-plugin-dts": "^4.5.4"
  }
}
